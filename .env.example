# ==============================================================================
# UHV ASSIGNMENT SUBMISSION PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="UHV Assignment Submission Portal"
API_V1_STR=/api/v1
SECRET_KEY=generate_a_super_secret_key_here_for_jwt_and_csrf_tokens_32chars
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost"]
TIMEZONE=Asia/Kolkata

# Server Host Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
VITE_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uhv_user
POSTGRES_PASSWORD=uhv_secure_password_2026
POSTGRES_DB=uhv_portal_db

# Redis Broker & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Storage & Temporary Upload Directory
UPLOAD_DIR=./data/uploads
TEMP_FILE_RETENTION_HOURS=72
MAX_CONCURRENT_PROCESSING_JOBS=6

# Assignment Default Configuration
ASSIGNMENT_TITLE="Universal Human Values (UHV) Assignment — PPT Presentation"
SUBMISSION_DEADLINE=2026-10-26T23:59:59
ALLOWED_SECTIONS=["CSE1","CSE2","CSE3","CSE-AI"]
ALLOWED_BRANCHES=["Computer Science and Engineering","Information Technology","Artificial Intelligence & Data Science"]
ALLOWED_YEARS=["2nd Year","3rd Year","4th Year"]
MAX_PPT_SIZE_MB=50
MAX_PDF_SIZE_MB=25
MAX_VIDEO_SIZE_MB=500
PDF_OPTIONAL_ALLOWED=true
PDF_REQUIRED=false
VIDEO_ALLOWED_EXTENSIONS=["mp4","mov","webm"]
SUBMISSIONS_OPEN=true

# Google Drive API Integration (OAuth 2.0)
# Instructions: Create OAuth 2.0 credentials in Google Cloud Console with Drive API enabled
GDRIVE_ENABLED=true
GDRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_google_client_secret
GDRIVE_REFRESH_TOKEN=your_google_refresh_token
GDRIVE_ROOT_FOLDER_NAME=UHV_Assignment_Submissions_2026
GDRIVE_UPLOAD_TIMEOUT_SECONDS=600

# Transactional Email Notification (SMTP)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=uhv.assignment.portal@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true
EMAIL_FROM=uhv.assignment.portal@gmail.com
TEACHER_EMAIL=teacher.uhv@university.edu.in

# Super Administrator Initial Credentials
FIRST_SUPERUSER_EMAIL=admin@uhv-portal.edu.in
FIRST_SUPERUSER_PASSWORD=AdminUHV@Pass2026!
