@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "$wifi = (Get-NetIPAddress -AddressFamily IPv4 -InterfaceAlias '*Wi-Fi*').IPAddress; if (-not $wifi) { $wifi = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' -and $_.IPAddress -notlike '192.168.56.*' -and $_.IPAddress -notlike '192.168.210.*' -and $_.IPAddress -notlike '172.20.*' } | Select-Object -First 1).IPAddress }; @{ wifi_ip = $wifi; portal_url = 'http://' + $wifi; port = 80; updated_at = (Get-Date).ToString('o') } | ConvertTo-Json | Set-Content -Path 'data\uploads\network_info.json'; Write-Host 'Wi-Fi IP updated to:' $wifi"
