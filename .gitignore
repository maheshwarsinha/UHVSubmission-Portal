# ==============================================================================
# Git Ignore - UHV Assignment Submission Portal
# ==============================================================================

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example
*.pem
*.key
*.cert

# Node.js & Frontend Builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/
.vite/
frontend/.vite/
package-lock.json.backup

# Python & Virtual Environments
__pycache__/
backend/**/__pycache__/
frontend/**/__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Databases & SQLite
*.db
*.sqlite
*.sqlite3
uhv_portal.db
backend/uhv_portal.db

# User Uploads, Media & Temporary Storage
data/
data/uploads/
data/postgres/
data/redis/
data/backups/
*.mp4
*.mov
*.webm
*.pptx
!load_testing/sample_files/**

# Scratch & Debug Scripts
scratch_*.py
scratchpad_*.md

# Background Workers & Task Queues
celerybeat-schedule*
*.pid

# Application & System Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.gemini/
.agents/
